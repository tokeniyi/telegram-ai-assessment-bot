# Copy this file to .env and fill in the values:   cp .env.example .env
# The bot reads everything from .env, whether it runs locally or on a server.

# ───────────── REQUIRED ─────────────

# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Telegram user IDs of the administrators (comma separated).
# Don't know your ID? Start the bot and send /myid, then put the number here and restart.
ADMIN_IDS=

# Your Kilo API key (https://app.kilo.ai -> profile -> API key).
# With the defaults below, this is the only AI setting you need to fill in.
AI_API_KEY=

# AI provider. "kilo" is the Kilo AI Gateway. Other options:
#   anthropic | openai | gemini | groq | openrouter | deepseek | mistral | ollama | custom
# (AI_API_KEY is then that provider's key; ollama needs none.)
AI_PROVIDER=kilo

# ───────────── OPTIONAL ─────────────

# Model name. Leave empty to use the provider's default:
#   kilo=kilo-auto/free  (Kilo's auto model: routes every request to a free model, $0)
#   anthropic=claude-opus-5-5   openai=gpt-4o-mini        gemini=gemini-2.5-flash
#   groq=llama-3.3-70b-versatile  openrouter=openai/gpt-4o-mini
#   deepseek=deepseek-chat      mistral=mistral-small-latest  ollama=llama3.1
AI_MODEL=

# Base URL of an OpenAI-compatible API. Required only for AI_PROVIDER=custom
# (it can also override the URL of any OpenAI-compatible provider above).
AI_BASE_URL=

# Seconds to wait for one AI response
AI_TIMEOUT_SECONDS=180

# Questions generated per document when the admin does not ask for a number
DEFAULT_NUM_QUESTIONS=5
# Hard upper limit on questions per assessment
MAX_QUESTIONS=30

# Largest upload accepted, in MB (Telegram bots cannot download files over 20 MB)
MAX_FILE_MB=20
# Longest document text sent to the AI, in characters. Longer documents are cut
# at this length and the admin is told.
MAX_DOCUMENT_CHARS=120000

# Show the reference answers to users after their submission is graded
SHOW_CORRECT_ANSWERS=true
# Let users submit more than once per assessment (the latest attempt counts)
ALLOW_RESUBMISSION=false

# Let users ask for explanations with /explain (each one is an AI request)
ALLOW_EXPLAIN=true

# ───────────── OCR (scanned PDFs and photos) ─────────────
# Runs on this machine with free open-source engines; no extra API key.

# Set to false to refuse files that have no text layer
OCR_ENABLED=true
# Engines, tried in this order; one that is not installed is skipped.
#   rapidocr  = PaddleOCR models (installed by requirements.txt)
#   tesseract = fallback, see requirements-ocr-extra.txt
#   easyocr   = optional fallback, see requirements-ocr-extra.txt
OCR_ENGINES=rapidocr,tesseract
# Pages read at the same time. Default 2. Each worker needs about 300 MB of memory;
# use 1 on a server with 1 GB of RAM, up to 4 on a larger one for long scans.
OCR_WORKERS=
# Most scanned pages read from one file: admins / everyone else
OCR_MAX_PAGES=150
OCR_MAX_PAGES_USER=15
# Resolution PDF pages are rendered at. Raise to 220 for very small print (slower).
OCR_DPI=170
# Pages read with less confidence than this (percent) are retried with image
# enhancement and the fallback engines, and reported to the uploader.
OCR_MIN_CONFIDENCE=80
# Languages for the tesseract fallback, e.g. eng+fra (needs the language packs)
OCR_TESSERACT_LANGS=eng

# The AI layer on top of local OCR. It uses your AI provider above.
#   off | auto | on
# OCR_VISION: send page images to the AI model so it can read handwriting, write
#   formulas as LaTeX and describe diagrams. auto = only pages that local OCR was
#   unsure about or that contain formulas or figures; on = every scanned page.
#   The model must accept images; if AI_MODEL does not, name one in OCR_VISION_MODEL
#   or set this to off. With kilo-auto/free this depends on which model Kilo picks.
OCR_VISION=auto
OCR_VISION_MODEL=
# Most page images sent to the AI model per file
OCR_VISION_MAX_PAGES=12
# OCR_AI_CORRECTION: let the AI repair recognition errors in the text.
#   auto = only low-confidence pages; on = every scanned page.
OCR_AI_CORRECTION=auto

# SQLite database file (created automatically)
DATABASE_PATH=data/bot.db

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
